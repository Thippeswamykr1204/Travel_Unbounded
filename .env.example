MONGODB_URI=

# Secret key required in the `x-admin-key` header to access GET /api/enquiry
ADMIN_API_KEY=

# Set to the real Vercel deployment URL after first deploy (used by
# app/robots.ts and app/sitemap.ts). Falls back to http://localhost:3000
# in local development.
NEXT_PUBLIC_SITE_URL=

JWT_SECRET=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Server-side only — never expose to the client. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=